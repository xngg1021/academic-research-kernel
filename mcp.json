{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "academic-skills": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${PLUGIN_ROOT}",
        "--python",
        "3.12",
        "--frozen",
        "--no-dev",
        "--no-editable",
        "academic-research-kernel",
        "mcp"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${PLUGIN_DATA}/runtime"
      }
    }
  }
}
