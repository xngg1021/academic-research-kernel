{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xngg1021/academic-research-kernel/main/schemas/research-documents.schema.json",
  "title": "Reproducible located research materials",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "fingerprint", "parser", "documents"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parser": {"type": "object", "additionalProperties": false,
      "required": ["name", "version", "implementation_sha256", "pdf_version", "fonttools_version", "config"],
      "properties": {"name": {"const": "ark-document-reader"}, "version": {"type": "string"},
        "implementation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "pdf_version": {"type": ["string", "null"]}, "fonttools_version": {"type": ["string", "null"]}, "config": {"type": "object", "additionalProperties": false,
          "required": ["pdf_mode", "ocr"], "properties": {"pdf_mode": {"const": "layout"}, "ocr": {"const": false}}}}},
    "documents": {"type": "array", "minItems": 1, "maxItems": 100,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["document_id", "relative_path", "sha256", "role", "format", "source_url", "status", "segments", "error", "title"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1}, "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "role": {"type": "string", "minLength": 1},
          "format": {"type": "string"}, "source_url": {"type": ["string", "null"]},
          "status": {"enum": ["parsed", "parse_failed"]}, "error": {"type": ["string", "null"]}, "title": {"type": "string"},
          "segments": {"type": "array", "maxItems": 100000,
            "items": {"type": "object", "additionalProperties": false,
              "required": ["locator", "text", "section", "page_index", "printed_page", "table_id"],
              "properties": {"locator": {"type": "string", "minLength": 1}, "text": {"type": "string"},
                "section": {"type": ["string", "null"]}, "page_index": {"type": ["integer", "null"], "minimum": 0},
                "printed_page": {"type": ["string", "null"]}, "table_id": {"type": ["string", "null"]}}}}
        }}}
  }
}
