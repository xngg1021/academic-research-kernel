{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xngg1021/academic-research-kernel/main/schemas/cross-review-artifact.schema.json",
  "title": "CrossReviewIssueRegistry",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    {"required": ["consensus"]},
    {"required": ["contradictions"]},
    {"required": ["singletons"]},
    {"required": ["findings"]}
  ],
  "properties": {
    "metadata": {"type": "object"},
    "stats": {"type": "object"},
    "consensus": {"type": "array", "items": {"type": "object"}},
    "contradictions": {"type": "array", "items": {"type": "object"}},
    "singletons": {"type": "array", "items": {"type": "object"}},
    "findings": {"type": "array", "items": {"type": "object"}},
    "dissenting_opinions": {"type": "array"},
    "complementarity_weights": {"type": "object"}
  }
}
