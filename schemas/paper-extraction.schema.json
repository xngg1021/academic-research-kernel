{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xngg1021/academic-research-kernel/main/schemas/paper-extraction.schema.json",
  "title": "Located paper extraction produced by a semantic reader",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_fingerprint", "paper", "producer", "search_scope", "fields", "summary", "checks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "paper": {"type":"object","additionalProperties":false,"required":["title","identifier","version"],"properties":{"title":{"type":"string","minLength":1},"identifier":{"type":"string","minLength":1},"version":{"type":"string","minLength":1}}},
    "producer": {"$ref":"#/$defs/producer"},
    "search_scope": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "fields": {"type":"array","minItems":10,"maxItems":1000,"items":{"$ref":"#/$defs/field"}},
    "summary": {"type":"object","additionalProperties":false,"required":["objective","design","main_results","attention"],"properties":{"objective":{"$ref":"#/$defs/statement"},"design":{"$ref":"#/$defs/statement"},"main_results":{"$ref":"#/$defs/statement"},"attention":{"$ref":"#/$defs/statement"}}},
    "checks": {"type":"array","maxItems":1000,"items":{"type":"object","additionalProperties":false,"required":["id","kind","inputs","reported","tail","note"],"properties":{"id":{"type":"string","minLength":1},"kind":{"enum":["t_p","effect_size","percentage"]},"inputs":{"type":"object","minProperties":1,"additionalProperties":{"type":"string","minLength":1}},"reported":{"type":["string","null"]},"tail":{"enum":["two","one",null]},"alternative":{"enum":["less","greater",null]},"note":{"type":"string"}}}}
  },
  "$defs": {
    "producer": {"type":"object","additionalProperties":false,"required":["kind","name","model"],"properties":{"kind":{"enum":["work","agent","human"]},"name":{"type":"string","minLength":1},"model":{"type":["string","null"]}}},
    "statement": {"type":"object","additionalProperties":false,"required":["text","field_ids"],"properties":{"text":{"type":"string","minLength":1},"field_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}}},
    "source": {"type":"object","additionalProperties":false,"required":["document_id","locator","quote"],"properties":{"document_id":{"type":"string","minLength":1},"locator":{"type":"string","minLength":1},"quote":{"type":"string","minLength":1}}},
    "context": {"type":"object","additionalProperties":false,"required":["group","timepoint","dataset","analysis_set","condition"],"properties":{"group":{"type":["string","null"]},"timepoint":{"type":["string","null"]},"dataset":{"type":["string","null"]},"analysis_set":{"type":["string","null"]},"condition":{"type":["string","null"]}}},
    "field": {"type":"object","additionalProperties":false,"required":["id","type","name","status","literal","value","unit","context","sources","reason"],"properties":{"id":{"type":"string","minLength":1},"type":{"enum":["number","integer","p_value","text","boolean"]},"name":{"type":"string","minLength":1},"status":{"enum":["extracted","not_found","explicitly_unreported","parse_failed","not_applicable"]},"literal":{"type":["string","null"]},"value":{"type":["number","string","boolean","null"]},"unit":{"type":["string","null"]},"context":{"$ref":"#/$defs/context"},"sources":{"type":"array","items":{"$ref":"#/$defs/source"}},"reason":{"type":["string","null"]}},"allOf":[{"if":{"properties":{"status":{"const":"extracted"}}},"then":{"properties":{"literal":{"type":"string","minLength":1},"value":{"not":{"type":"null"}},"sources":{"minItems":1}}},"else":{"properties":{"value":{"type":"null"},"reason":{"type":"string","minLength":1}}}}]}
  }
}
