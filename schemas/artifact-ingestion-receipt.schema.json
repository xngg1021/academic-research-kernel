{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xngg1021/academic-research-kernel/main/schemas/artifact-ingestion-receipt.schema.json",
  "title": "ArtifactIngestionReceipt",
  "description": "Deterministic receipt proving ingestion of a research artifact into the kernel state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "receipt_id",
    "source_artifact_id",
    "source_artifact_sha256",
    "adapter_id",
    "adapter_version",
    "status",
    "validation_state",
    "output_digests"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "ingestion-receipt-1.0"
    },
    "receipt_id": {
      "type": "string",
      "description": "Deterministic identifier derived from canonical ingestion inputs (ingest- + 32 hex chars).",
      "pattern": "^ingest-[0-9a-f]{32}$"
    },
    "source_artifact_id": {
      "type": "string",
      "pattern": "^art-[0-9a-f]{32}$"
    },
    "source_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]{1,64}$"
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "type": "string",
      "enum": ["accepted", "rejected", "partial"]
    },
    "ingestion_context_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_lineage_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "receipt_id", "receipt_digest"],
      "properties": {
        "kind": {"const": "lineage"},
        "schema_version": {"const": "lineage-receipt-1.0"},
        "receipt_id": {"type": "string", "minLength": 1},
        "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "locator": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "validation_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "errors"],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "created_or_reused_objects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ceg_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ceg_edges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ledger_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "binding_kind", "basis_id"],
        "properties": {
          "decision_id": {
            "type": "string"
          },
          "binding_kind": {
            "type": "string",
            "enum": ["decision", "negative_result", "outcome_correction", "evidence_receipt", "reproduction_receipt", "computed_evidence", "review_finding", "uncertainty", "ledger_decision", "ledger_fork", "ledger_state_event"]
          },
          "basis_id": {
            "type": "string"
          },
          "record_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "binding_kind": {"const": "ledger_decision"}
              },
              "required": ["binding_kind"]
            },
            "then": {
              "required": ["record_digest"]
            }
          }
        ]
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ignored_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_registry_digest",
        "receipt_registry_digest",
        "uncertainty_state_digest",
        "ingested_artifact_digest",
        "kernel_content_digest"
      ],
      "properties": {
        "object_registry_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ceg_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ledger_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipt_registry_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "uncertainty_state_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ingested_artifact_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kernel_content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "failure_reason": {
      "type": "string"
    },
    "caller_metadata": {
      "type": "object"
    }
  }
}
