{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xngg1021/academic-research-kernel/main/schemas/retraction-delta.schema.json",
  "title": "RetractionWatchDelta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "is_retracted",
    "signals"
  ],
  "properties": {
    "doi": {
      "type": "string",
      "minLength": 1
    },
    "target_work_id": {
      "type": "string",
      "minLength": 1
    },
    "is_retracted": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_status": {
      "enum": [
        "verified_current",
        "retained_prior",
        "unverified"
      ]
    },
    "current_observation": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "observation_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Local query-start order reserved before HTTP; older or duplicate commits cannot replace a newer DOI observation."
    },
    "confirmed_observation_version": {
      "type": "integer",
      "minimum": 0,
      "description": "Version of the last known boolean, independent of a newer unknown current observation; 0 denotes an unversioned legacy baseline."
    },
    "source_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openalex": {
          "enum": ["verified", "not_found", "unavailable", "invalid_response"]
        },
        "crossref": {
          "enum": ["verified", "unavailable", "invalid_response"]
        }
      }
    },
    "source_errors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openalex": {"type": "string"},
        "crossref": {"type": "string"}
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "retraction_reason": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "verification_status"
        ],
        "properties": {
          "verification_status": {
            "const": "retained_prior"
          }
        }
      },
      "then": {
        "properties": {
          "is_retracted": {
            "type": "boolean"
          },
          "current_observation": {
            "type": "null"
          }
        }
      },
      "else": {
        "if": {
          "required": [
            "current_observation"
          ]
        },
        "then": {
          "oneOf": [
            {
              "properties": {
                "is_retracted": {
                  "const": true
                },
                "current_observation": {
                  "const": true
                }
              }
            },
            {
              "properties": {
                "is_retracted": {
                  "const": false
                },
                "current_observation": {
                  "const": false
                }
              }
            },
            {
              "properties": {
                "is_retracted": {
                  "const": null
                },
                "current_observation": {
                  "const": null
                }
              }
            }
          ]
        }
      }
    }
  ]
}
