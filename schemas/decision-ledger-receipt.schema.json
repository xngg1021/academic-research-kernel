{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xngg1021/academic-research-kernel/schemas/decision-ledger-receipt.schema.json",
  "title": "DecisionLedgerReceipt",
  "description": "Deterministic export of a Decision & Negative Result Ledger v1: decisions, basis edges, fork edges, prune states, outcome corrections, and the uncertainty queue. No confidence scores; verdicts are discrete enumerations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "ledger_id",
    "ledger_digest",
    "decisions",
    "bases",
    "forks",
    "prune_states",
    "corrections"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "decision-ledger-1.0"
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "ledger_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "bases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/basisEdge"
      }
    },
    "forks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forkEdge"
      }
    },
    "prune_states": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pruneState"
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outcomeCorrection"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertaintyItem"
      }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "normalized_title", "decision_type", "decision_digest"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "normalized_title": {
          "type": "string"
        },
        "decision_type": {
          "type": "string",
          "enum": ["explore", "commit", "abandon", "revise", "negative_result"]
        },
        "decision_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_work_id": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "basisEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "basis_kind", "basis_id"],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "basis_kind": {
          "type": "string",
          "enum": ["claim", "negative_result"]
        },
        "basis_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "receipt_ref": {
          "$ref": "#/$defs/receiptRef"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "forkEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "alternative_id", "relation"],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "alternative_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "relation": {
          "type": "string",
          "enum": ["considered", "explored", "deferred", "rejected"]
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "pruneState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "status"],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "status": {
          "type": "string",
          "enum": ["active", "pruned"]
        },
        "prune_reason": {
          "type": "string",
          "enum": [
            "resource_exhausted",
            "superseded",
            "contradicted",
            "out_of_scope",
            "duplicate",
            "external_constraint",
            "investigator_error",
            "other"
          ]
        },
        "pruned_by": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "alternative_ref": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "receipt_ref": {
          "$ref": "#/$defs/receiptRef"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "outcomeCorrection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correction_id", "decision_id", "verdict", "rationale", "outcome_digest", "sequence"],
      "properties": {
        "correction_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "verdict": {
          "type": "string",
          "enum": ["positive", "negative", "inconclusive", "unverifiable"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "outcome_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "receipt_ref": {
          "$ref": "#/$defs/receiptRef"
        },
        "locator": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "uncertaintyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "subject_id", "kind", "reason", "needs_human"],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^unc-[0-9a-f]{16}$"
        },
        "subject_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "decision_without_basis",
            "unsupported_negative_result",
            "missing_receipt",
            "unsupported_pruning",
            "generic_uncertainty"
          ]
        },
        "reason": {
          "type": "string"
        },
        "needs_human": {
          "type": "boolean"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "receiptRef": {
      "type": "object",
      "oneOf": [
        {
          "description": "LineageReceipt reference",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "lineage"
            },
            "schema_version": {
              "const": "lineage-receipt-1.0"
            },
            "receipt_id": {
              "type": "string"
            },
            "receipt_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "locator": {
              "type": "string"
            }
          },
          "required": ["kind", "schema_version", "receipt_id", "receipt_digest"]
        },
        {
          "description": "AcademicEvidenceReceipt reference",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "academic_evidence"
            },
            "schema_version": {
              "const": "1.0"
            },
            "claim_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "payload_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "locator": {
              "type": "string"
            }
          },
          "required": ["kind", "schema_version", "claim_digest", "payload_sha256"]
        }
      ]
    }
  }
}
