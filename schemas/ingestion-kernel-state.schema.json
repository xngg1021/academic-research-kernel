{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xngg1021/academic-research-kernel/main/schemas/ingestion-kernel-state.schema.json",
  "title": "IngestionKernelState",
  "description": "Complete stateless-MCP round-trippable snapshot of the deterministic research-state kernel.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "snapshot_digest",
    "ceg",
    "ledger",
    "objects",
    "receipts",
    "uncertainties",
    "ingested_artifacts",
    "ingestion_receipts",
    "content_digests"
  ],
  "properties": {
    "protocol": {"const": "ingestion-kernel-state-1.0"},
    "snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ceg": {"type": ["object", "null"]},
    "ledger": {"type": ["object", "null"]},
    "objects": {"type": "object", "propertyNames": {"type": "string", "minLength": 1}, "additionalProperties": {"type": "object"}},
    "receipts": {"type": "object", "propertyNames": {"type": "string", "minLength": 1}, "additionalProperties": {"type": "object"}},
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "subject_id", "kind", "reason", "needs_human"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "subject_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "needs_human": {"type": "boolean"},
          "metadata": {"type": "object"}
        }
      }
    },
    "ingested_artifacts": {
      "type": "object",
      "propertyNames": {"type": "string", "pattern": "^art-[0-9a-f]{32}$"},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "ingestion_receipts": {
      "type": "object", "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"type": "object"}
    },
    "content_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_registry_digest",
        "receipt_registry_digest",
        "uncertainty_state_digest",
        "ingested_artifact_digest",
        "kernel_content_digest"
      ],
      "properties": {
        "object_registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "receipt_registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "uncertainty_state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ingested_artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ceg_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ledger_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "kernel_content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
