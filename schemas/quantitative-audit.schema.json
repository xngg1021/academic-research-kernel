{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xngg1021/academic-research-kernel/main/schemas/quantitative-audit.schema.json",
  "title": "QuantitativeAuditArtifact",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertions"],
      "properties": {
        "paper_title": {"type": "string"},
        "assertions": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/result"}
        }
      }
    },
    {"$ref": "#/$defs/result"}
  ],
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {"required": ["reported", "recomputed", "formula", "library"]},
        {"required": ["reported_value", "recomputed_value", "discrepancy_detected"]},
        {"required": ["consistent"]}
      ],
      "properties": {
        "statistic": {"type": "string"},
        "reported": {},
        "recomputed": {},
        "difference": {"type": ["number", "null"]},
        "reported_value": {},
        "recomputed_value": {},
        "discrepancy_detected": {"type": "boolean"},
        "consistent": {"type": ["boolean", "null"]},
        "inputs": {"type": "object"},
        "formula": {"type": "string"},
        "library": {"type": "string"},
        "confidence": {"type": "string"},
        "locator": {"type": ["string", "null"]},
        "note": {"type": "string"},
        "ci_midpoint": {"type": "number"},
        "estimate": {"type": "number"},
        "relative_deviation": {"type": "number"},
        "implied_se": {"type": "number"},
        "tolerance": {"type": "number"},
        "decimals": {"type": "integer", "minimum": 0},
        "reported_sd": {"type": "number"},
        "max_possible_sd": {"type": "number"},
        "excess": {"type": "number"},
        "implied_n": {"type": ["integer", "null"]},
        "reported_n": {"type": "integer"},
        "value_a": {"type": "number"},
        "value_b": {"type": "number"},
        "denominator": {"type": "number"},
        "recomputed_percent": {"type": "number"},
        "min_possible_denominator": {"type": "integer", "minimum": 1},
        "implied_denominator": {"type": "number"},
        "nearest_denominator": {"type": "integer", "minimum": 1}
      }
    }
  }
}
