{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xngg1021/academic-research-kernel/main/schemas/systematic-review-artifact.schema.json",
  "title": "SystematicReviewArtifact",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    {"required": ["included_studies"]},
    {"required": ["screening_results"]},
    {"required": ["meta_analysis"]}
  ],
  "properties": {
    "included_studies": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "screening_results": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "meta_analysis": {"type": "object"},
    "protocol_id": {"type": "string"}
  }
}
