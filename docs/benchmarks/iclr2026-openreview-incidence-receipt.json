{
  "schema_version": "1.1.0",
  "study_id": "iclr2026-openreview-5family-incidence-v1",
  "measurement_scope": "lexical_keyword_screening_mention_rate",
  "description": "De-identified paper-level lexical keyword-screening mention rates across 5 topic families in official ICLR 2026 peer-review Weaknesses and Questions fields. Because regex matching is polarity-blind (e.g. 'confidence intervals are correctly reported' or 'reproducibility is excellent' also match), these rates measure topic-term mention/screening prevalence inside Weaknesses/Questions rather than manually adjudicated defect ground truth.",
  "reproduction_command": "python tools/benchmarks/run_peer_review_and_incidence_benchmarks.py --mirror-dir <dir> --verify-iclr2026-incidence",
  "known_limitations": [
    "Lexical regexes match topic phrases without sentiment/negation parsing; positive or neutral mentions inside Weaknesses/Questions (such as praising reproducibility or comprehensive limitations) are counted alongside critiques.",
    "Join denominator (19,473 scored manuscripts, 75,769 reviews) requires both a non-empty review list in iclr2026_stats.jsonl and a matching forum ID in iclr2026.json."
  ],
  "methodology": {
    "unit_of_analysis": "scored_manuscript",
    "text_fields_concatenated": [
      "reviews[*].weaknesses",
      "reviews[*].questions"
    ],
    "aggregation_rule": "k / N manuscripts where at least one official review matches the category regex (case-insensitive)",
    "split_half_rule": "int(hashlib.sha256(forum_id.encode('utf-8')).hexdigest(), 16) % 2",
    "zero_fitted_parameters": true,
    "regex_patterns": {
      "dispersion_error_bars": "\\b(?:error\\s+bars?|standard\\s+deviations?|std\\b|stdev\\b|confidence\\s+intervals?|statistical\\s+significance|multiple\\s+(?:runs|seeds)|random\\s+seeds?|variance\\s+across)\\b",
      "format_section_page": "\\b(?:typos?|grammatical|grammar\\s+errors?|broken\\s+references?|missing\\s+references?|citation\\s+format|template|page\\s+limit|over\\s+length|limitations?\\s+section|no\\s+limitations?|lack\\s+of\\s+limitations?|unresolved\\s+reference)\\b",
      "table_quant_ablation": "\\b(?:inconsistent\\s+numbers?|mismatch\\s+between\\s+table|table\\s+\\d+\\s+and\\s+table\\s+\\d+|ablation\\s+study\\s+is\\s+missing|no\\s+ablation|marginal\\s+improvement|overclaimed|over-claimed|hyperbole|exaggerated|numbers?\\s+in\\s+table\\s+\\d+\\s+do\\s+not\\s+match|sum\\s+to\\s+100)\\b",
      "citation_baseline": "\\b(?:missing\\s+citations?|missing\\s+references?|outdated\\s+baselines?|recent\\s+baselines?|duplicate\\s+citations?|duplicate\\s+references?|wrong\\s+citation|incorrect\\s+citation|hallucinated\\s+reference|non-existent\\s+reference)\\b",
      "reproducibility_code": "\\b(?:no\\s+code|code\\s+is\\s+not\\s+provided|code\\s+is\\s+not\\s+available|missing\\s+code|anonymous\\s+(?:code|repo|repository|link)|reproducib(?:le|ility)|hyperparameters?\\s+are\\s+not\\s+specified|implementation\\s+details?\\s+are\\s+missing)\\b"
    }
  },
